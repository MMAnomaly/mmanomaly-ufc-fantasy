# Local Postgres via `docker compose up -d` (see docker-compose.yml).
# Production (Vercel/Neon): use the pooled URL here. `postgres://` and `postgresql://` both work.
DATABASE_URL="postgresql://mmanomaly:mmanomaly@localhost:5432/mmanomaly"

# Direct (unpooled) URL for `prisma migrate deploy`. Same as DATABASE_URL for local Docker.
# On Vercel Postgres / Neon, use the non-pooling connection string.
DIRECT_URL="postgresql://mmanomaly:mmanomaly@localhost:5432/mmanomaly"

# JWT session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public origin used when building invite URLs in emails/scripts (optional locally; set on Vercel).
APP_URL="http://localhost:3000"

# Protects GET|POST /api/jobs/sunday-score and /api/jobs/draft-tick.
# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET> when the env var is set.
# Generate with: openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-string"

# Optional. Team picture uploads go to Vercel Blob when this is set.
# Vercel project → Storage → Blob → create a store, then copy the read/write token.
# Local dev without it stores files in public/uploads/avatars (gitignored).
# On Vercel without it, members paste a public image URL instead of uploading.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Optional: seed a demo commissioner + invitee (see README).
# SEED_DEMO="true"
# DEMO_COMMISSIONER_EMAIL="commish@mmanomaly.local"
# DEMO_COMMISSIONER_PASSWORD="draftready"
# DEMO_PLAYER_EMAIL="player@mmanomaly.local"
# DEMO_PLAYER_PASSWORD="draftready"
