# SQLite (local demo). Prisma schema is Postgres-ready — see README to switch.
DATABASE_URL="file:./dev.db"

# JWT session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public origin used when building invite URLs in emails/scripts (optional; UI uses window.origin).
APP_URL="http://localhost:3000"

# Protects POST /api/jobs/sunday-score (cron / platform scheduler).
CRON_SECRET="replace-with-a-long-random-string"

# Optional: seed a demo commissioner + invitee (see README).
# SEED_DEMO="true"
# DEMO_COMMISSIONER_EMAIL="commish@mmanomaly.local"
# DEMO_COMMISSIONER_PASSWORD="draftready"
# DEMO_PLAYER_EMAIL="player@mmanomaly.local"
# DEMO_PLAYER_PASSWORD="draftready"
